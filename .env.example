# Copy to .env.local and fill in. Never commit real values: only this file is tracked.
#
# SECURITY: Vite inlines every VITE_* variable into the public JavaScript bundle.
# Never put a secret (API key, token) in a VITE_* variable.

# --- Frontend (public, read by Vite) ---

# Base URL of the backend API proxy that calls the LLM: http://localhost:3000 with
# `npm run dev:api`. CI takes it from the VITE_API_URL repository variable.
VITE_API_URL=https://api.example.com
# Path the app is served from: / locally, /<repo>/ on GitHub Pages (set in CI).
VITE_BASE_PATH=/

# --- Backend (secret, read only by the API proxy) ---
# Set these in the backend platform's secret store, never in the frontend build.

# Gemini API key from Google AI Studio. Create it in a Google Cloud project without
# billing enabled, so requests above the free-tier quota are rejected instead of charged.
LLM_API_KEY=
# Gemini model ID used for the analysis. Empty means gemini-3.1-flash-lite.
LLM_MODEL=
# Origins allowed by CORS, comma-separated, each without path or trailing slash,
# e.g. https://devtomaszstoklosa.github.io,http://localhost:5173 for local development.
ALLOWED_ORIGIN=https://devtomaszstoklosa.github.io
